# Atuin is in the Fedora repositories (18.12.1 on F45). This package
# provides the latest upstream release (18.25.1) for Fedora CoreOS.
#
# Fedora CoreOS / rpm-ostree notes:
# - No scriptlets of any kind; safe for ostree layering.
# - All payload installs under /usr (part of the ostree image).
# - The all-users subpackage installs a /etc/profile.d script, which is
#   writable on CoreOS and works with rpm-ostree layering.
#
# The [patch.crates-io] section in the workspace Cargo.toml patches
# axoasset to use a vendored copy (vendor/axoasset) to avoid pulling in
# a second TLS backend. The vendored source is included in the git
# archive tarball, so no additional Source is needed.
#
# Atuin vendors its own copy of bash-preexec (vendor/bash-preexec),
# embedded at compile time via include_trimmed!. The init scripts
# generated by `atuin init` will use the built-in copy if the system
# bash-preexec is not available, but we still require it for
# compatibility with existing setups.

%global debug_package %{nil}
%undefine _package_note_file

Name:           atuin
Version:        18.25.1
Release:        1%{?dist}
Summary:        Magical shell history

License:        MIT
URL:            https://github.com/atuinsh/atuin
Source0:        %{url}/archive/refs/tags/v%{version}/%{name}-%{version}.tar.gz

Requires:       bash-preexec

# Atuin's workspace MSRV is 1.95.0; it uses edition 2024 (Rust 1.85+).
BuildRequires:  cargo >= 1.95
BuildRequires:  rust >= 1.95
# C compiler for tree-sitter (bundled C), zstd-sys, and linking.
BuildRequires:  gcc
# C++ compiler for mlua-sys (bundled Luau interpreter).
BuildRequires:  g++
# System libraries linked at runtime or during the build.
BuildRequires:  pkgconfig(openssl)
BuildRequires:  pkgconfig(sqlite3)
# arboard (clipboard) on Linux uses wayland-data-control.
BuildRequires:  pkgconfig(wayland-client)

%description
Atuin replaces your existing shell history with a SQLite database, and
records additional context for your commands. Additionally, it provides
optional and fully encrypted synchronization of your history between
machines, via an Atuin server.

%package        all-users
Summary:        atuin init script for all users
Requires:       %{name} = %{version}-%{release}
BuildArch:      noarch

%description    all-users
This package contains the init script to enable atuin for all users
via /etc/profile.d/atuin.sh.

%prep
%autosetup

%build
# --locked for reproducible builds; the Cargo.lock is committed at the tag.
# -p atuin builds only the main binary crate (not the server or other
# workspace members).
export RUSTFLAGS='-C strip=symbols'
cargo build --release --locked -p atuin

# Generate shell completions and static init scripts using the built binary.
mkdir -p other_installs/shell_completion other_installs/libexec/atuin
for shell in bash fish zsh; do
    target/release/%{name} gen-completions --shell "${shell}" \
        -o other_installs/shell_completion
    target/release/%{name} init "${shell}" \
        > other_installs/libexec/atuin/atuin-init.${shell}
done

# Generate the profile.d script for the all-users subpackage.
mkdir -p other_installs/profile.d
cat > other_installs/profile.d/atuin.sh << EOF
# atuin initialization script for all users
# Currently only bash and zsh is supported

# Check for bash environment
if [ -n "\${BASH_VERSION-}" ]; then
  # Skip noninteractive shells.
  [[ \$- != *i* ]] && return

  # Use the statically written atuin init script
  source %{_libexecdir}/%{name}/atuin-init.bash

# Check for zsh environment
elif [ -n "\${ZSH_VERSION-}" ]; then
  # Skip noninteractive shells.
  [[ \$- != *i* ]] && return

  # The /etc/zprofile script calls 'emulate -L ksh', to make zsh
  # happier when sourcing files in /etc/profile.d. However, atuin
  # needs some zsh-specific functions (i.e. compinit), so we emulate
  # zsh when sourcing the statically written atuin init script. See
  # /etc/zprofile or 'man zshbuiltins' for more details.
  emulate zsh -c "source %{_libexecdir}/%{name}/atuin-init.zsh"
fi
EOF

%install
install -Dpm 0755 target/release/%{name} %{buildroot}%{_bindir}/%{name}

# Shell completions.
install -Dpm 0644 other_installs/shell_completion/atuin.bash \
    -t %{buildroot}%{_datadir}/bash-completion/completions
install -Dpm 0644 other_installs/shell_completion/atuin.fish \
    -t %{buildroot}%{_datadir}/fish/vendor_completions.d
install -Dpm 0644 other_installs/shell_completion/_atuin \
    -t %{buildroot}%{_datadir}/zsh/site-functions

# Static atuin init scripts.
for shell in bash fish zsh; do
    install -Dpm 0755 other_installs/libexec/atuin/atuin-init.${shell} \
        %{buildroot}%{_libexecdir}/%{name}/atuin-init.${shell}
done

# Profile.d init script for all users.
install -Dpm 0755 other_installs/profile.d/atuin.sh \
    %{buildroot}%{_sysconfdir}/profile.d/atuin.sh

%check
target/release/%{name} --version

%files
%license LICENSE
%doc CHANGELOG.md README.md
%{_bindir}/%{name}
%{_datadir}/bash-completion/completions/atuin.bash
%{_datadir}/fish/vendor_completions.d/atuin.fish
%{_datadir}/zsh/site-functions/_atuin
%{_libexecdir}/%{name}

%files all-users
%config(noreplace) %{_sysconfdir}/profile.d/atuin.sh

