%global debug_package %{nil}

# Based on the official Fedora spec (go2rpm-generated). Adapted for Fedora
# CoreOS / rpm-ostree: everything is installed under /usr (bindir and man
# pages), so the package layers cleanly on immutable Fedora where /opt is
# a symlink to /var/opt.
#
# Uses upstream's signed release "src-deps" tarball (full source tree with
# the vendor/ directory included) as the single source, so no separately
# generated vendor tarball is needed.
%bcond check 1

%global gomodulesmode GO111MODULE=on
# https://github.com/rfjakob/gocryptfs
%global goipath         github.com/rfjakob/gocryptfs/v2
Version:                2.7.0

# Top-level directory name inside the src-deps release tarball
%define topdir gocryptfs_v%{version}_src-deps

%gometa -L -f

Name:           gocryptfs
Release:        1%{?dist}
Summary:        Encrypted overlay filesystem written in Go

# Generated by go-vendor-tools
License:        Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND MIT
URL:            %{gourl}
Source0:        %{gourl}/releases/download/v%{version}/gocryptfs_v%{version}_src-deps.tar.gz
Source1:        go-vendor-tools.toml

BuildRequires:  gcc
%if 0%{?fedora}
BuildRequires:  go-vendor-tools
%endif
BuildRequires:  pandoc
BuildRequires:  pkgconfig(libcrypto)
BuildRequires:  /usr/bin/fusermount

Requires:       fuse3

%description
Encrypted overlay filesystem written in Go.

%prep
# -k keeps the vendor/ directory shipped in the src-deps tarball
%goprep -A -k
%autopatch -p1

%if 0%{?fedora}
%generate_buildrequires
%go_vendor_license_buildrequires -c %{S:1}
%endif

%build
export GO_LDFLAGS="-X main.GitVersion=%{version} \
      -X main.GitVersionFuse=$(go list -m github.com/hanwen/go-fuse/v2 | cut -d' ' -f2-) \
      -X main.BuildDate=$(date -u --date="@${SOURCE_DATE_EPOCH}" +%Y-%m-%d)"
%gobuild -o %{gobuilddir}/bin/gocryptfs %{goipath}
%gobuild -o %{gobuilddir}/bin/gocryptfs-xray %{goipath}/gocryptfs-xray
./Documentation/MANPAGE-render.bash

%install
%if 0%{?fedora}
%go_vendor_license_install -c %{S:1}
%endif
install -m 0755 -vd                     %{buildroot}%{_bindir}
install -m 0755 -vp %{gobuilddir}/bin/* %{buildroot}%{_bindir}/
install -Dpm644 Documentation/gocryptfs.1 -t %{buildroot}%{_mandir}/man1
install -Dpm644 Documentation/gocryptfs-xray.1 -t %{buildroot}%{_mandir}/man1

%check
%if 0%{?fedora}
%go_vendor_license_check -c %{S:1}
%endif
%if %{with check}
# Requires the allow_other option in /etc/fuse
for test in "TestForceOwner" \
            "TestGetdents" \
; do
awk -i inplace '/^func.*'"$test"'\(/ { print; print "\tt.Skip(\"disabled failing test\")"; next}1' $(grep -rl $test)
done
sed -i '/allow_other:/d' tests/cli/directmount_test.go
# Requires root
rm -rf tests/root_test
# Hardcoded paths
ln -s %{gobuilddir}/bin/gocryptfs .
ln -s %{gobuilddir}/bin/gocryptfs-xray gocryptfs-xray
%gotest ./...
%endif

%if 0%{?fedora}
%files -f %{go_vendor_license_filelist}
%else
%files
%endif
%license vendor/modules.txt
%doc README.md
%{_bindir}/gocryptfs
%{_bindir}/gocryptfs-xray
%{_mandir}/man1/gocryptfs-xray.1.*
%{_mandir}/man1/gocryptfs.1.*

